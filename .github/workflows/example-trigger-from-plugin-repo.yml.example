# EXAMPLE WORKFLOW - Copy this to your plugin repo's .github/workflows/
#
# This workflow triggers the rtd-claude-inn marketplace to update your plugin version
# when you create a new release.
#
# Prerequisites:
# 1. Create a GitHub PAT with 'repo' scope
# 2. Add it as a secret named 'MARKETPLACE_DISPATCH_TOKEN' in your plugin repo
#
# To use:
# 1. Copy this file to your plugin repo as .github/workflows/notify-marketplace.yml
# 2. Update PLUGIN_NAME to match your plugin's name in the marketplace
# 3. Create a new release in your repo - marketplace will auto-update

name: Notify Marketplace

on:
  release:
    types: [published]

jobs:
  notify-marketplace:
    runs-on: ubuntu-latest
    steps:
      - name: Trigger marketplace version bump
        env:
          # Your plugin name as registered in rtd-claude-inn marketplace
          PLUGIN_NAME: "your-plugin-name"
          # The release tag (e.g., v1.2.3 or 1.2.3)
          RELEASE_TAG: ${{ github.event.release.tag_name }}
          RELEASE_BODY: ${{ github.event.release.body }}
          DISPATCH_TOKEN: ${{ secrets.MARKETPLACE_DISPATCH_TOKEN }}
        run: |
          # Strip 'v' prefix from tag if present
          VERSION="${RELEASE_TAG#v}"

          echo "Notifying marketplace of $PLUGIN_NAME v$VERSION"

          curl -X POST \
            -H "Accept: application/vnd.github+json" \
            -H "Authorization: Bearer $DISPATCH_TOKEN" \
            -H "X-GitHub-Api-Version: 2022-11-28" \
            https://api.github.com/repos/ryanthedev/rtd-claude-inn/dispatches \
            -d "$(jq -n \
              --arg plugin "$PLUGIN_NAME" \
              --arg version "$VERSION" \
              --arg changelog "$RELEASE_BODY" \
              '{
                event_type: "plugin-version-bump",
                client_payload: {
                  plugin_name: $plugin,
                  version: $version,
                  changelog: $changelog
                }
              }')"

          echo "Marketplace notification sent!"
